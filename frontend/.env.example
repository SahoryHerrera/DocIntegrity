# Copia este archivo como .env y completa los valores.
# Todo lo que empieza por VITE_ se incrusta en el código del navegador:
# NO pongas aquí secretos (Jwt:Secret, claves privadas, cadenas de conexión).
# Esos valores viven solo en el backend (dotnet user-secrets).

# URL base de DocIntegrity.Api (perfil "http" de launchSettings.json).
VITE_API_URL=http://localhost:5235

# ID de cliente OAuth de Google (público). Debe coincidir con Google:ClientId del backend.
VITE_GOOGLE_CLIENT_ID=

# Opcional, solo para mostrar en la sección Blockchain.
# Dirección del contrato DocumentRegistry desplegado con Hardhat Ignition.
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_NAME=Hardhat local
